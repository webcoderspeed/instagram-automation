### User Signup API Tests

@baseUrl = http://localhost:3000
@contentType = application/json

### 1. User Signup - Valid Request
POST {{baseUrl}}/api/auth/signup
Content-Type: {{contentType}}

{
  "email": "test8@example.com",
  "username": "johndo342342e",
  "password": "SecurePassword123!"
}

### 2. User Signup - Missing Required Fields
POST {{baseUrl}}/api/auth/signup
Content-Type: {{contentType}}

{
  "email": "test2@example.com",
  "password": "SecurePassword123!",
  "username": "testuser2",
  "firstName": "Test",
  "lastName": "User",
  "acceptTerms": true
}

### 3. User Signup - Invalid Email Format
POST {{baseUrl}}/api/auth/signup
Content-Type: {{contentType}}

{
  "email": "invalid-email",
  "username": "janedoe",
  "password": "SecurePassword123!",
  "firstName": "Jane",
  "lastName": "Doe",
  "acceptTerms": true
}

### 4. User Signup - Weak Password
POST {{baseUrl}}/api/auth/signup
Content-Type: {{contentType}}

{
  "email": "test3@example.com",
  "username": "bobsmith",
  "password": "123",
  "firstName": "Bob",
  "lastName": "Smith",
  "acceptTerms": true
}

### 5. User Signup - Missing Username
POST {{baseUrl}}/api/auth/signup
Content-Type: {{contentType}}

{
  "email": "test4@example.com",
  "password": "SecurePassword123!",
  "firstName": "Alice",
  "lastName": "Johnson",
  "acceptTerms": true
}

### 6. User Signup - Duplicate Email
POST {{baseUrl}}/api/auth/signup
Content-Type: {{contentType}}

{
  "email": "test@example.com",
  "username": "duplicateuser",
  "password": "SecurePassword123!",
  "firstName": "Duplicate",
  "lastName": "User",
  "acceptTerms": true
}